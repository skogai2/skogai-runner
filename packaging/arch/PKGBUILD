# skogai core into /usr/share/skogai. builds the repo's committed HEAD, not
# the working tree; makepkg's own src/ and pkg/ stay in this directory
pkgname=skogai-runner-git
pkgver=r40.be9c9cb
pkgrel=1
pkgdesc='skogai core: usage scripts for the skogai runner'
arch=(any)
url='https://github.com/skogai2/skogai-runner'
license=(unknown)
depends=(usage bash jq)
makedepends=(git)
checkdepends=(bats)
provides=(skogai-runner)
conflicts=(skogai-runner)
source=("skogai-runner::git+file://${startdir%/packaging/arch}")
sha256sums=(SKIP)

pkgver() {
    cd skogai-runner
    printf 'r%s.%s' "$(git rev-list --count HEAD)" "$(git rev-parse --short=7 HEAD)"
}

check() {
    cd skogai-runner
    bats tests
}

package() {
    cd skogai-runner
    install -Dm755 src/core/log/usage.sh "$pkgdir/usr/share/skogai/core/log/usage.sh"
}
