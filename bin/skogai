#!/usr/bin/env bash
# skogai <module> <cmd>...: run a module's argc command with its env (`skogai system env`);
# anything else goes to core, with core's env
set -euo pipefail

root="$(cd "$(dirname "$(realpath "${BASH_SOURCE[0]}")")/.." && pwd)"
export SKOGAI_MODULE_PATH="${SKOGAI_MODULE_PATH:+$SKOGAI_MODULE_PATH:}$root/modules"
core="$root/modules/core/argc.sh"
export SKOGAI_BIN="$root/bin/skogai"

case "${1:-}" in
"" | -* | system | help) ;;
*)
    if cmd="$(argc --argc-run "$core" system command "$1" 2>/dev/null)"; then
        eval "$(argc --argc-run "$core" system env "$1")"
        shift
        exec argc --argc-run "$cmd" "$@"
    fi
    ;;
esac
eval "$(argc --argc-run "$core" system env core)"
exec argc --argc-run "$core" "$@"
